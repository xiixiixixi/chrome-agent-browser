{
  "name": "chrome-agent-browser",
  "version": "0.2.1",
  "description": "Let MCP agents drive your real Chromium-family browser (with your logged-in sessions): extension + native host + local service, one-command setup",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "chrome-agent-browser": "setup.mjs",
    "chrome-agent-browser-mcp": "service/mcp-entry.mjs",
    "chrome-agent-browser-doctor": "doctor.mjs",
    "chrome-agent-browser-uninstall": "uninstall.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check host/host.mjs && node --check service/service.mjs && node --check installer/install.mjs && node --check service/locator.mjs && node --check service/api.mjs && node --check service/mcp.mjs",
    "e2e": "node test/e2e/run-e2e.mjs",
    "selftest": "node service/service.mjs --selftest && node service/mcp-entry.mjs --help || true",
    "setup": "node setup.mjs",
    "uninstall": "node uninstall.mjs",
    "doctor": "node doctor.mjs",
    "start": "node service/service.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "zod": "^3.23.8",
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "files": [
    "extension/",
    "host/host.mjs",
    "installer/",
    "service/",
    "shared/",
    "docs/PROTOCOL.md",
    "setup.mjs",
    "uninstall.mjs",
    "doctor.mjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiixiixixi/chrome-agent-browser.git"
  },
  "homepage": "https://github.com/xiixiixixi/chrome-agent-browser#readme",
  "bugs": {
    "url": "https://github.com/xiixiixixi/chrome-agent-browser/issues"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "browser-automation",
    "chrome",
    "chromium",
    "arc",
    "extension",
    "agent"
  ]
}